/**
 * 按兵种 ID 检索静态配置（纯只读查询辅助函数）
 */
export function getUnitConfigById(unitId: UnitTypeId): UnitStaticStats | undefined {
  for (let i: number = 0; i < UNIT_STATIC_CONFIGS.length; i++) {
    if (UNIT_STATIC_CONFIGS[i].id === unitId) {
      return UNIT_STATIC_CONFIGS[i];
    }
  }
  return undefined;
}
